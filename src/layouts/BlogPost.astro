---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";

const { frontmatter } = Astro.props;
---

<Layout
	title={frontmatter.title + " – Martin Sollien"}
	description={frontmatter.metaDescription}
>
	<Header />
	<article
		id="article"
		class="w-full mb-24 p-4 md:p-0 flex flex-col items-center px-4 lg:px-20 relative"
	>
		<ArticleHeader headerEffect={frontmatter.headerEffect}>
			{frontmatter.title}
		</ArticleHeader>
		<div class="md:grid md:grid-cols-4 md:gap-10 w-full">
			<div class="mb-12 md:col-span-1 relative mm-metadata-column" data-mm-metadata-column>
				<div
					class="w-full border-main-default border p-4 sticky top-0"
				>
					<p>METADATA</p>
					<hr class="mt-4 mb-4 border-dashed" />
					<dl>
						<div class="flex justify-between mb-4">
							<dt>AUTHOR</dt>
							<dd>Martin Sollien</dd>
						</div>
						<div class="flex justify-between mb-4">
							<dt>DATE</dt>
							<dd>{frontmatter.date}</dd>
						</div>
						<div class="flex justify-between mb-4">
							<dt>CATEGORY</dt>
							<dd class="flex gap-4">
								<span
									class="border border-dashed border-main-default p-1 py-[2px] text-sm"
									>{frontmatter.categories}</span
								>
							</dd>
						</div>
						{frontmatter.score && (
							<hr class="mt-4 mb-4 border-dashed" />
							<div class="flex justify-between items-center">
								<dt>KARAKTER</dt>
								<dd>
									{
										frontmatter.score && (
											<div class="ml-5 mt-1 dice-container">
												<div
													class={`dice dice-${frontmatter.score}`}
												>
													{Array.from({
														length: frontmatter.score,
													}).map((_, i) => (
														<div class="dot" />
													))}
												</div>
											</div>
										)
									}
								</dd>
							</div>
						)}
					</dl>
				</div>
			</div>
			<div class="md:col-span-2 flex justify-center">
				<div class="w-full max-w-prose relative" data-mm-article-content>
					{frontmatter.description?.trim() && (
						<h2 id="description" class="text-xl mb-12">
							{frontmatter.description}
						</h2>
					)}
					{
						frontmatter.preface &&
							frontmatter.preface.length > 0 && (
								<div class="mb-12 border border-cyan-400 bg-cyan-950 p-4">
									<p class="font-bold before:content-['(!)'] before:font-normal before:pr-2 before:text-cyan-400 before:tracking-tight mb-2">
										Preface
									</p>
									<p>{frontmatter.preface}</p>
								</div>
							)
					}
					<slot class="main-blog-content" />
				</div>
			</div>
			<div class="md:col-span-1"></div>
		</div>
	</article>
</Layout>

<script is:inline>
	(() => {
		const firstTextLineTopFromNode = (node) => {
			if (!node) return null;

			if (node.nodeType === Node.TEXT_NODE) {
				const value = node.textContent?.trim();
				if (!value) return null;
				const range = document.createRange();
				range.selectNodeContents(node);
				const rects = range.getClientRects();
				if (!rects.length) return null;
				return rects[0].top;
			}

			if (node.nodeType !== Node.ELEMENT_NODE) return null;

			const element = node;
			const tagName = element.tagName?.toUpperCase();
			if (tagName === "BR" || tagName === "SCRIPT" || tagName === "STYLE") {
				return null;
			}

			const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
				acceptNode: (textNode) =>
					textNode.textContent?.trim()
						? NodeFilter.FILTER_ACCEPT
						: NodeFilter.FILTER_SKIP,
			});

			const textNode = walker.nextNode();
			if (!textNode) return null;

			const range = document.createRange();
			range.selectNodeContents(textNode);
			const rects = range.getClientRects();
			if (!rects.length) return null;
			return rects[0].top;
		};

		const firstBodyLineTop = (content, leadGraphic) => {
			let node = leadGraphic.nextSibling;
			while (node) {
				const top = firstTextLineTopFromNode(node);
				if (top !== null) return top;
				node = node.nextSibling;
			}

			const fallback = content.querySelector("p");
			if (!fallback) return null;
			const rect = fallback.getBoundingClientRect();
			return rect.top;
		};

		const updateMetadataOffset = () => {
			const article = document.getElementById("article");
			const metadataColumn = article?.querySelector("[data-mm-metadata-column]");
			const content = article?.querySelector("[data-mm-article-content]");
			if (!article || !metadataColumn || !content) return;

			if (window.innerWidth < 768) {
				metadataColumn.style.setProperty("--mm-metadata-offset", "0px");
				return;
			}

			const leadGraphic = content.querySelector(".mm-article-graphic--lead");
			if (!leadGraphic) {
				metadataColumn.style.setProperty("--mm-metadata-offset", "0px");
				return;
			}

			const lineTop = firstBodyLineTop(content, leadGraphic);
			if (lineTop === null) {
				metadataColumn.style.setProperty("--mm-metadata-offset", "0px");
				return;
			}

			const metadataTop = metadataColumn.getBoundingClientRect().top;
			const offset = Math.max(0, Math.round(lineTop - metadataTop));
			metadataColumn.style.setProperty("--mm-metadata-offset", `${offset}px`);
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", updateMetadataOffset, { once: true });
		} else {
			updateMetadataOffset();
		}

		window.addEventListener("resize", updateMetadataOffset);
		window.addEventListener("load", updateMetadataOffset);
	})();
</script>

<style lang="scss">
	.mm-metadata-column {
		--mm-metadata-offset: 0px;
	}

	@media (min-width: 768px) {
		.mm-metadata-column {
			padding-top: var(--mm-metadata-offset);
		}
	}

	:global(#article h2:not(#description, #secondary-title)) {
		font-size: 20px;
		font-weight: 600;
		margin-top: 40px;
		margin-bottom: 10px;
	}

	:global(.mm-article-graphic) {
		width: 100%;
		margin-bottom: 2rem;
	}

	:global(.mm-article-graphic--wide-desktop) {
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		width: 100vw;
		max-width: none;
	}

	@media (min-width: 1024px) {
		:global(.mm-article-graphic--wide-desktop) {
			width: min(980px, calc(100vw - 3rem));
			max-width: 980px;
		}
	}

	:global(.fact-box) {
		padding: 1rem;
		border: var(--default-border);

		&::before {
			display: block;
			padding-bottom: 8px;
			margin-bottom: 8px;
			content: "Facts!";
			font-weight: bold;
			border-bottom: 1px solid #defcfa;
		}
	}

	.dice-container {
		display: inline-block;
	}

	.dice {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(3, 1fr);
		width: 2.1rem;
		height: 2.1rem;
		background-color: #98ff5c;
		padding: 4px;
		gap: 1px;
		position: relative;
	}

	.dot {
		width: 0.5rem;
		height: 0.5rem;
		background-color: black;
		border-radius: 50%;
		justify-self: center;
		align-self: center;
	}

	/* Dice patterns based on standard dice configuration */
	/* For dice-1, show only the middle dot */
	.dice-1 .dot:nth-child(1) {
		grid-area: 2 / 2; /* Center dot in the middle of the grid */
	}

	/* For dice-2, show top-left and bottom-right */
	.dice-2 .dot:nth-child(1) {
		grid-area: 1 / 1;
	}
	.dice-2 .dot:nth-child(2) {
		grid-area: 3 / 3;
	}

	/* For dice-3, add the middle dot */
	.dice-3 .dot:nth-child(1) {
		grid-area: 1 / 1;
	}
	.dice-3 .dot:nth-child(2) {
		grid-area: 2 / 2;
	}
	.dice-3 .dot:nth-child(3) {
		grid-area: 3 / 3;
	}

	/* For dice-4, show all four corners */
	.dice-4 .dot:nth-child(1) {
		grid-area: 1 / 1;
	}
	.dice-4 .dot:nth-child(2) {
		grid-area: 1 / 3;
	}
	.dice-4 .dot:nth-child(3) {
		grid-area: 3 / 1;
	}
	.dice-4 .dot:nth-child(4) {
		grid-area: 3 / 3;
	}

	/* For dice-5, add the middle dot */
	.dice-5 .dot:nth-child(1) {
		grid-area: 1 / 1;
	}
	.dice-5 .dot:nth-child(2) {
		grid-area: 1 / 3;
	}
	.dice-5 .dot:nth-child(3) {
		grid-area: 2 / 2;
	}
	.dice-5 .dot:nth-child(4) {
		grid-area: 3 / 1;
	}
	.dice-5 .dot:nth-child(5) {
		grid-area: 3 / 3;
	}

	/* For dice-6, show 3 dots on each side */
	.dice-6 .dot:nth-child(1) {
		grid-area: 1 / 1;
	}
	.dice-6 .dot:nth-child(2) {
		grid-area: 1 / 3;
	}
	.dice-6 .dot:nth-child(3) {
		grid-area: 2 / 1;
	}
	.dice-6 .dot:nth-child(4) {
		grid-area: 2 / 3;
	}
	.dice-6 .dot:nth-child(5) {
		grid-area: 3 / 1;
	}
	.dice-6 .dot:nth-child(6) {
		grid-area: 3 / 3;
	}
</style>
