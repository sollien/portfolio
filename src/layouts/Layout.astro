---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible&family=Istok+Web&display=swap"
			rel="stylesheet"
		/>
		<!-- 100% privacy-first analytics -->
		<script async src="https://scripts.simpleanalyticscdn.com/latest.js"
		></script>
		<script defer src="/scripts/hide-embed-blocks.js"></script>
		<script defer src="/scripts/datawrapper-skeleton.js"></script>
	</head>
	<body class="relative scroll-smooth">
		<slot />
	</body>
</html>

<style is:global lang="scss">
	$opacity-1: 0;
	$opacity-2: 0.08;

	@keyframes glow {
		0% {
			box-shadow:
				inset 0px 0px 20px rgba(211, 255, 252, $opacity-1),
				0px 0px 20px rgba(211, 255, 252, $opacity-1);
		}
		50% {
			box-shadow:
				inset 0px 0px 20px rgba(211, 255, 252, $opacity-2),
				0px 0px 20px rgba(211, 255, 252, $opacity-2);
		}
		100% {
			box-shadow:
				inset 0px 0px 20px rgba(211, 255, 252, $opacity-1),
				0px 0px 20px rgba(211, 255, 252, $opacity-1);
		}
	}

	@keyframes blink {
		0% {
			opacity: 0;
		}
		49% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
		100% {
			opacity: 1;
		}
	}

	@keyframes mm-ascii-flicker {
		0% {
			opacity: 0.9;
		}
		30% {
			opacity: 1;
		}
		31% {
			opacity: 0.75;
		}
		32% {
			opacity: 1;
		}
		100% {
			opacity: 0.9;
		}
	}

	@keyframes mm-ascii-glitch {
		0% {
			transform: translate(0, 0);
		}
		20% {
			transform: translate(0, 0);
		}
		21% {
			transform: translate(1px, 0);
		}
		22% {
			transform: translate(-1px, 0);
		}
		23% {
			transform: translate(0, 0);
		}
		100% {
			transform: translate(0, 0);
		}
	}

	@keyframes mm-ascii-scan {
		0% {
			background-position: 0 0;
		}
		100% {
			background-position: 0 14px;
		}
	}

	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
		--main-color-5: #fcffff;
		--main-color-default: #defcfa;
		--main-color-30: #6f7e7d;
		--main-color-35: #899c9b;
		--main-color-40: #a5bbba;
		--main-color-70: #434c4b;
		--main-color-85: #262d2d;
		--main-color-90: #121615;
		--default-border: 1px solid var(--main-color-default);
		--highlight-color-default: hsl(98, 100%, 68%); //#98ff5c
	}

	.main-400 {
		color: var(--main-color-40);
	}

	.main-default {
		color: var(--main-color-default);
	}

	html {
		display: flex;
		justify-content: center;
	}

	body {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100vh;
		width: 100%;
		font-family: "Space Mono", monospace;
		font-size: 14px;
		letter-spacing: 1px;
		color: var(--main-color-default);
		background: var(--main-color-90);
		background-size: 224px;

		#mouseDot {
			position: absolute;
			width: 10px;
			height: 10px;
			background-color: var(--main-color-35);
			border-radius: 100%;
		}
	}

	main {
		display: flex;
		flex-direction: column;
		flex: 1;
		height: 100%;
	}

	h1:not(header h1, article h1, #page-title),
	h2:not(article h2) {
		&::before {
			content: ">/";
			color: var(--highlight-color-default);
		}

		&::after {
			content: "_";
			color: var(--highlight-color-default);
			animation: blink 1s infinite;
		}
	}

	p {
		max-width: 600px;
	}

	hr {
		color: #defcfa;
		border-color: var(--main-default);
	}

	.link-button {
		display: block;
		width: 100%;
		padding: 10px 15px;
		background-color: var(--highlight-color-default);
		color: var(--main-color-90);
		font-weight: 600;

		&:hover {
			box-shadow:
				inset 0px 0px 20px rgba(211, 255, 252, 0.2),
				0px 0px 20px rgba(211, 255, 252, 0.2);
		}
	}

	.mm-inline-badge-link {
		display: inline-block;
		padding: 2px 8px;
		border: 1px solid var(--highlight-color-default);
		background: var(--highlight-color-default);
		color: var(--main-color-90);
		font-style: normal;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 120ms ease,
			box-shadow 120ms ease,
			filter 120ms ease;

		&:hover {
			transform: translateY(-2px);
			filter: brightness(1.05);
			box-shadow:
				inset 0px 0px 14px rgba(255, 255, 255, 0.25),
				0px 0px 14px rgba(152, 255, 92, 0.45);
		}
	}

	.mm-dw-shell {
		position: relative;
		overflow: hidden;
		height: var(--mm-dw-skeleton-height, 250px);
		min-height: var(--mm-dw-skeleton-height, 250px);
		border: 1px solid var(--main-color-70);
		background: rgba(18, 22, 21, 0.3);
		transition:
			background 220ms ease,
			border-color 220ms ease,
			height 220ms ease,
			min-height 220ms ease;
	}

	.mm-dw-skeleton {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: "Space Mono", monospace;
		background:
			repeating-linear-gradient(
				to bottom,
				rgba(152, 255, 92, 0.07) 0px,
				rgba(152, 255, 92, 0.07) 1px,
				rgba(18, 22, 21, 0.95) 1px,
				rgba(18, 22, 21, 0.95) 7px
			),
			var(--main-color-90);
		animation: mm-ascii-scan 260ms linear infinite;
		transition: opacity 220ms ease;

		&::before {
			content: "+--------------------------------------+\A| GRAPHIC LOADING                     |\A|                                      |\A| [||||||||||||||||||...............] |\A| syncing tiles..... 72%              |\A|                                      |\A+--------------------------------------+";
			white-space: pre;
			padding: 10px 14px;
			border: 1px solid var(--main-color-default);
			color: var(--main-color-default);
			font-size: 12px;
			line-height: 1.25;
			letter-spacing: 0.4px;
			text-shadow:
				0 0 6px rgba(222, 252, 250, 0.2),
				0 0 1px rgba(222, 252, 250, 0.6);
			animation:
				mm-ascii-flicker 1200ms steps(2, end) infinite,
				mm-ascii-glitch 2600ms steps(1, end) infinite;
		}

		&::after {
			content: "> GRAPHIC LOADING_";
			position: absolute;
			right: 16px;
			bottom: 12px;
			color: var(--main-color-default);
			font-size: 12px;
			letter-spacing: 1px;
			animation: blink 800ms steps(1, end) infinite;
		}
	}

	.mm-dw-shell.mm-is-loaded .mm-dw-skeleton {
		opacity: 0;
		visibility: hidden;
	}

	.mm-dw-shell.mm-is-loaded {
		background: transparent;
		border-color: transparent;
		height: auto;
		min-height: var(--mm-dw-skeleton-height, 250px);
	}

	.mm-dw-shell.mm-is-loaded > [id^="datawrapper-vis-"] {
		height: auto !important;
		min-height: var(--mm-dw-skeleton-height, 250px) !important;
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	.book-item,
	.project-item,
	.content-header,
	.content-image-container,
	.base-section {
		animation: glow 10s infinite;
	}

	.content-header {
		padding: 100px 30px 10px 30px;
		border: var(--default-border);
	}

	.content-section {
		border-left: var(--default-border);
		border-right: var(--default-border);
	}

	.summary-col {
		padding: 10px 30px;
	}

	.details-col {
		padding: 10px 30px;
	}

	.content-image-container {
		width: 100%;
		border-top: var(--default-border);
		border-bottom: var(--default-border);
	}

	.base-section {
		flex: 1;
		padding: 10px 30px;
		border-left: var(--default-border);
		border-right: var(--default-border);
	}

	.block-getTheData,
	.block-attribution,
	.separator {
		display: none !important;
	}

	.block-headline,
	.block-description {
		color: inherit !important;
		font-family: inherit !important;
	}

	.container.container-body {
		background: transparent !important;
		background-color: transparent !important;
	}

	@media (min-width: 1024px) {
		.project-item:hover {
			.text-glow {
				text-shadow:
					0 0 10px #fff,
					0 0 20px #ffffff,
					0 0 30px #121615,
					0 0 40px #121615,
					0 0 50px #121615,
					0 0 60px #121615,
					0 0 70px #121615;
			}
		}
	}
</style>
