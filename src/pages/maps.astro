---
import MapsArchivePage from "@/components/MapsArchivePage.astro";
import { getMapCategories, loadMapPosts } from "@/lib/mapArchive";

const posts = loadMapPosts();
const categories = getMapCategories(posts);
---

<MapsArchivePage
    pageTitle="Maps"
    metaDescription="A collection of maps, charts, and visual storytelling projects."
    intro="Here is my collection of selected maps that I've made over the years. I've primarily made editorial maps for the Norwegian newspaper Aftenposten."
    {posts}
    {categories}
    allPostsCount={posts.length}
/>
